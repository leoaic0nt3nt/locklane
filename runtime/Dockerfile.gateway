FROM golang:1.27.4-bookworm AS build
WORKDIR /build
COPY gate.go .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /gate gate.go
FROM ghcr.io/sagernet/sing-box:v1.14.4 AS singbox
FROM ghcr.io/xtls/xray-core:26.11.9 AS xray
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl iproute2 iptables wireguard-tools wireguard-go util-linux gnupg && \
    curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg && \
    printf '%s\n' 'deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian bookworm main' > /etc/apt/sources.list.d/tailscale.list && \
    apt-get update && apt-get install -y --no-install-recommends tailscale && rm -rf /var/lib/apt/lists/*
COPY --from=singbox /usr/local/bin/sing-box /usr/local/bin/sing-box
COPY --from=xray /usr/local/bin/xray /usr/local/bin/xray
COPY --from=build /gate /usr/local/bin/locklane-gate
COPY gateway.sh /usr/local/bin/locklane-gateway
RUN chmod 755 /usr/local/bin/locklane-gateway
ENTRYPOINT ["/usr/local/bin/locklane-gateway"]
HEALTHCHECK --interval=3s --timeout=2s --retries=1 CMD ["/usr/local/bin/locklane-gate", "check"]
